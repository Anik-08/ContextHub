# ContextHub Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it contains secrets.

# ----- Required -----
# Get a free Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ----- Security (V5) -----
# Signs JWTs. In production this MUST be a long random string.
# Omit it in local dev: a random key is generated per boot (logs you out on restart).
SECRET_KEY=change-me-to-a-long-random-string
# Token lifetime in minutes. Default: 1440 (24h).
JWT_EXPIRES_MINUTES=1440

# ----- Database (V5) -----
# Default: SQLite at ./contexthub.db (zero setup).
# To use PostgreSQL (recommended in Docker):
#   DATABASE_URL=postgresql+psycopg://contexthub:contexthub@localhost:5432/contexthub
# Cloud (Neon/Supabase free tier): paste their URL as-is — the app auto-switches
# a plain `postgresql://` URL to the psycopg driver.
DATABASE_URL=sqlite:///./contexthub.db

# ----- CORS -----
# Comma-separated allowed browser origins (your frontend).
# Local dev defaults are built in; set this to your Vercel URL in production:
#   CORS_ORIGINS=https://contexthub.vercel.app
# CORS_ORIGINS=

# ----- Vector DB (ChromaDB) -----
# Local mode (default): data persists to CHROMA_PERSIST_DIR on disk. Great for
# docker-compose / dev.
#
# Remote mode: required on hosts with ephemeral disks (Render free tier).
# Point at a hosted Chroma instance — Chroma Cloud free tier or self-hosted:
#   CHROMA_HOST=xxxxx.chroma.app        # host/endpoint from your Chroma dashboard
#   CHROMA_PORT=8000                    # always 8000 with SSL for Chroma Cloud
#   CHROMA_SSL=true
#   CHROMA_API_KEY=<your_chroma_token>  # X-Chroma-Token auth
#   CHROMA_TENANT=default-tenant        # optional; Chroma Cloud may assign a tenant id
#   CHROMA_DATABASE=default_database    # optional
# CHROMA_HOST=
# CHROMA_PORT=8000
# CHROMA_SSL=false
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# ----- Optional (defaults are fine) -----
# Groq model options:
#   groq/compound-mini     → fast, generous free quota, no thinking (DEFAULT)
#   openai/gpt-oss-20b     → smarter reasoning model, clean answer output
#   qwen/qwen3.8-27b       → strong qwen3, requires reasoning_effort=none
GROQ_MODEL=groq/compound-mini

# Max output tokens per LLM call — keep well under the free-tier OTPM
# (output tokens per minute) cap so requests don't get rejected with 429.
LLM_MAX_TOKENS=600

# Embedding model (sentence-transformers, runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K_RESULTS=5

# Storage (relative paths from the backend/ directory)
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./uploads
REPO_DIR=./repos